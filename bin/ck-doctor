#!/usr/bin/env bash
# ck-doctor — health checks for continuity-kit.
# Usage: ck-doctor [--notify | --json | --quiet]
# Exit:  0 healthy (warnings allowed), 1 critical failure
set -euo pipefail

NOTIFY=0 JSON=0 QUIET=0
for a in "$@"; do
  case "$a" in
    --notify) NOTIFY=1 ;;
    --json)   JSON=1 ;;
    --quiet)  QUIET=1 ;;
    -h|--help) sed -n '2,5p' "$0"; exit 0 ;;
    *) echo "usage: ck-doctor [--notify|--json|--quiet]" >&2; exit 2 ;;
  esac
done

crit=0 warn=0
declare -a results=()

_pass() { results+=("ok   $1"); }
_fail() { results+=("FAIL $1"); crit=$((crit + 1)); }
_warn() { results+=("warn $1"); warn=$((warn + 1)); }

_run()  { local l="$1"; shift; if "$@" >/dev/null 2>&1; then _pass "$l"; else _fail "$l"; fi; }
_runw() { local l="$1"; shift; if "$@" >/dev/null 2>&1; then _pass "$l"; else _warn "$l"; fi; }

_dev_paired() { [[ -n "$(kdeconnect-cli -l --id-only 2>/dev/null)" ]]; }
_dev_reach()  { [[ -n "$(kdeconnect-cli -a --id-only 2>/dev/null)" ]]; }
_notif_ok()   { pgrep -x swaync >/dev/null || pgrep -x mako >/dev/null || pgrep -x dunst >/dev/null; }
_clip_ok()    { printf x | wl-copy && [[ "$(wl-paste 2>/dev/null)" == x ]]; }
_ports_ok()   { systemctl --user is-active --quiet xdg-desktop-portal \
                && systemctl --user is-active --quiet xdg-desktop-portal-hyprland; }

_run  "kdeconnectd running"  pgrep -x kdeconnectd
_run  "phone paired"         _dev_paired
_runw "phone reachable"      _dev_reach
_run  "notification daemon"  _notif_ok
_run  "clipboard round-trip" _clip_ok
_run  "desktop portals"      _ports_ok
_run  "syncthing service"    systemctl --user is-active --quiet syncthing.service

fw="none"
systemctl is-active --quiet ufw 2>/dev/null && fw="ufw"
systemctl is-active --quiet firewalld 2>/dev/null && fw="firewalld"
results+=("info firewall: $fw")

if command -v adb >/dev/null 2>&1; then
  adb_n="$(adb devices 2>/dev/null | awk 'NR>1 && $2=="device"' | wc -l | tr -d ' ')"
  results+=("info adb devices connected: ${adb_n:-0}")
fi

summary="continuity-kit doctor: $(( ${#results[@]} - crit - warn )) ok, ${warn} warn, ${crit} fail"

if ((JSON)); then
  printf '{"ok":%s,"failed":%d,"warnings":%d,"checks":[' "$([[ $crit -eq 0 ]] && echo true || echo false)" "$crit" "$warn"
  first=1
  for r in "${results[@]}"; do
    ((first)) || printf ','
    first=0
    printf '"%s"' "${r//\"/}"
  done
  printf ']}\n'
elif ((QUIET)); then
  :
else
  for r in "${results[@]}"; do echo "$r"; done
  echo "$summary"
fi

if ((NOTIFY)); then
  if ((crit == 0)); then
    notify-send -a continuity-kit "continuity-kit" "healthy ($warn warnings)"
  else
    notify-send -a continuity-kit -u critical "continuity-kit" "$crit checks failing — run ck-doctor"
  fi
fi

((crit == 0))
